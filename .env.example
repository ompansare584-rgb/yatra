# Copy to .env.local for local work. Never commit real values.

# The final deployed origin, e.g. https://your-domain.example
# Read ONLY on the server (src/lib/site-url.ts) for canonical URLs, sitemap, Open Graph, JSON-LD.
# On Vercel, if this is empty, the production domain Vercel provides is used automatically.
SITE_URL=

# Optional alternative to SITE_URL (also read only on the server).
NEXT_PUBLIC_SITE_URL=

# Optional. Your Formspree endpoint, e.g. https://formspree.io/f/abcdwxyz
# Leave empty and the contact form is simply not shown (LinkedIn + GitHub links appear instead).
NEXT_PUBLIC_FORMSPREE_URL=
